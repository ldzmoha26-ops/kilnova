rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidRagDocument(data) {
      return data.keys().hasAll([
          'authorUid',
          'title',
          'section',
          'source',
          'collection',
          'verificationStatus',
          'content',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'authorUid',
          'title',
          'section',
          'source',
          'collection',
          'verificationStatus',
          'content',
          'createdAt'
        ])
        && data.authorUid is string
        && data.authorUid == request.auth.uid
        && isValidId(data.authorUid)
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 200
        && data.section is string && data.section.size() >= 2 && data.section.size() <= 120
        && data.source is string && data.source.size() >= 2 && data.source.size() <= 160
        && data.collection in ['technical_docs', 'equipment_registry', 'procedures']
        && data.verificationStatus in ['VERIFIED', 'PENDING PLANT VALIDATION', 'PROTOTYPE CONFIGURED']
        && data.content is string && data.content.size() >= 20 && data.content.size() <= 12000
        && data.createdAt is timestamp;
    }

    function isValidRagIncident(data) {
      return data.keys().hasAll([
          'authorUid',
          'case_id',
          'date',
          'severity',
          'problem',
          'context',
          'action_taken',
          'result_30_min',
          'result_60_min',
          'tags',
          'dataOrigin',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'authorUid',
          'case_id',
          'date',
          'severity',
          'problem',
          'context',
          'action_taken',
          'result_30_min',
          'result_60_min',
          'tags',
          'dataOrigin',
          'createdAt'
        ])
        && data.authorUid is string
        && data.authorUid == request.auth.uid
        && isValidId(data.authorUid)
        && data.case_id is string && data.case_id.size() >= 4 && data.case_id.size() <= 40
        && data.case_id.matches('^[A-Z0-9\\-]+$')
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.severity in ['WARNING', 'CRITICAL', 'EMERGENCY']
        && data.problem is string && data.problem.size() >= 5 && data.problem.size() <= 300
        && data.context is string && data.context.size() >= 10 && data.context.size() <= 2000
        && data.action_taken is string && data.action_taken.size() >= 10 && data.action_taken.size() <= 2000
        && data.result_30_min is string && data.result_30_min.size() >= 3 && data.result_30_min.size() <= 400
        && data.result_60_min is string && data.result_60_min.size() >= 3 && data.result_60_min.size() <= 400
        && data.tags is list && data.tags.size() >= 1 && data.tags.size() <= 8
        && data.tags[0] is string && data.tags[0].size() >= 1 && data.tags[0].size() <= 40
        && data.dataOrigin in ['DEMONSTRATION DATA', 'USER SUBMITTED LOG']
        && data.createdAt is timestamp;
    }

    match /rag_documents/{docId} {
      allow get: if isSignedIn() && isValidId(docId) && existing().authorUid == request.auth.uid;
      allow list: if isSignedIn() && resource.data.authorUid == request.auth.uid;
      allow create: if isVerified()
        && isValidId(docId)
        && isValidRagDocument(incoming())
        && incoming().createdAt == request.time;
      allow update: if isVerified()
        && isValidId(docId)
        && isValidRagDocument(incoming())
        && existing().authorUid == request.auth.uid
        && incoming().authorUid == existing().authorUid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'section', 'content', 'verificationStatus']);
      allow delete: if isVerified() && isValidId(docId) && existing().authorUid == request.auth.uid;
    }

    match /rag_incidents/{incidentId} {
      allow get: if isSignedIn() && isValidId(incidentId) && existing().authorUid == request.auth.uid;
      allow list: if isSignedIn() && resource.data.authorUid == request.auth.uid;
      allow create: if isVerified()
        && isValidId(incidentId)
        && isValidRagIncident(incoming())
        && incoming().createdAt == request.time;
      allow update: if isVerified()
        && isValidId(incidentId)
        && isValidRagIncident(incoming())
        && existing().authorUid == request.auth.uid
        && incoming().authorUid == existing().authorUid
        && incoming().createdAt == existing().createdAt
        && incoming().case_id == existing().case_id
        && incoming().diff(existing()).affectedKeys().hasOnly(['context', 'action_taken', 'result_30_min', 'result_60_min', 'tags']);
      allow delete: if isVerified() && isValidId(incidentId) && existing().authorUid == request.auth.uid;
    }
  }
}
